# Supabase Configuration
# Get these from your Supabase project settings (Settings > General)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Vapi Configuration (Voice AI Agent)
# Get these from your Vapi dashboard (https://dashboard.vapi.ai)
VITE_VAPI_PUBLIC_KEY=your-vapi-public-key-here
VITE_VAPI_ASSISTANT_ID=your-vapi-assistant-id-here

# Optional: LLM Provider Key (if using Claude via Vapi)
# OPENAI_API_KEY=your-openai-api-key-here

# Optional: Webhook Secret (for future use)
# WEBHOOK_SECRET=your-webhook-secret-here
